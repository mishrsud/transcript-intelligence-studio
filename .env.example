# Copy to .env. Never commit .env or put this secret in frontend variables.
KINDE_DOMAIN=https://sudhanshutheone.kinde.com
KINDE_CLIENT_ID=be8486f517de44d88712a1f5fa8ce694
KINDE_CLIENT_SECRET=
# Register this API identifier in Kinde and authorize the web application for it. Required; no custom scopes or permission claims are used.
KINDE_AUDIENCE=youtube-transcriber
# Native default. For Vite development use http://127.0.0.1:5173.
APP_URL=http://127.0.0.1:8000
# Docker browser origin (container still listens on port 8000).
DOCKER_APP_URL=http://127.0.0.1:8001
# SMTP for transcript/insight email delivery. Required fields are host and from address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Use starttls (port 587) or ssl (typically port 465).
SMTP_SECURITY=starttls
